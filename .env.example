# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shs_scheduler
JWT_SECRET=generate-a-long-random-string

# Phase 3 (all optional)
# Address of the web app, used to build public share links
PUBLIC_APP_URL=http://localhost:3000
# Comma-separated emails of the people who run the whole service (all schools)
PLATFORM_ADMIN_EMAILS=
# Secret a payment provider signs its webhook calls with; empty turns the webhook off
BILLING_WEBHOOK_SECRET=
# Lets students follow a section for change notifications. Generate with:
#   cd backend; .\.venv\Scripts\python.exe -m app.push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for the push services (mailto: or https:)
VAPID_SUBJECT=mailto:noreply@example.com

# Instead of the POSTGRES_* values: a hosted database's full connection string (for example Neon)
DATABASE_URL=
