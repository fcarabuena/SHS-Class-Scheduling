# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shs_scheduler
JWT_SECRET=generate-a-long-random-string

# Phase 3 (all optional)
# Address of the web app, used to build public share links
PUBLIC_APP_URL=http://localhost:3000
# Comma-separated emails of the people who run the whole service (all schools)
PLATFORM_ADMIN_EMAILS=
# Secret a payment provider signs its webhook calls with; empty turns the webhook off
BILLING_WEBHOOK_SECRET=
